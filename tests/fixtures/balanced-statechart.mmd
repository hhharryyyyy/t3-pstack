stateDiagram-v2
  direction LR
  classDef breaks fill:#ffecee,stroke:#e72e3b,color:#cd2834
  classDef mayBreak fill:#fff3e6,stroke:#e8730c,color:#b85a06
  [*] --> Queued
  state "Waiting for a worker" as Queued
  state "Processing the request" as Processing {
    [*] --> Read
    state "Read the latest saved version" as Read
    state "Write the result while the lease is valid" as Write
    Read --> Write: validation passes
    Write --> Committed: transaction commits
    state "Result committed" as Committed
  }
  Queued --> Processing: worker claims the job
  Processing --> Complete: acknowledgement arrives
  Processing --> Conflict: another worker owns the lease
  Processing --> Uncertain: connection closes before acknowledgement
  Uncertain --> Retry: retry with the same request identifier
  Retry --> Queued: request remains pending
  Complete --> Archived: retention period ends
  state "Safe to show the result" as Complete
  state "Write accepted after the lease expired" as Conflict
  state "The result may have been committed" as Uncertain
  state "Waiting before the next attempt" as Retry
  state "Archived result" as Archived
  class Queued blue
  class Read teal
  class Write purple
  class Write bugPath
  class Committed yellow
  class Complete orange
  class Conflict tan
  class Conflict breaks
  class Conflict bugPath
  class Uncertain pink
  class Uncertain mayBreak
  class Retry repeats
  class Retry bugPath
